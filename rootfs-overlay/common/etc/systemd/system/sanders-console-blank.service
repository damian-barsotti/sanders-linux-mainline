[Unit]
Description=Blank the display (tty1 console) after 5 minutes of inactivity
After=getty@tty1.service

[Service]
Type=oneshot
# Write to tty1 by redirection instead of StandardInput=tty: with the latter
# systemd waits for tty1 to be free, and the autologin session holds it.
ExecStart=/bin/sh -c 'TERM=linux /usr/bin/setterm --blank 5 --powerdown 5 > /dev/tty1 < /dev/tty1'

[Install]
WantedBy=multi-user.target
